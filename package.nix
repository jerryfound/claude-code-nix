# Packages the Claude Code CLI from the official prebuilt binaries
# published on npm (@anthropic-ai/claude-code-<platform> packages),
# instead of compiling from source.
#
# Version and hashes live in hashes.json, which is regenerated by
# scripts/update.py from npm registry metadata. Do not edit by hand.
#
# The npm registry mirror at npmmirror.com serves byte-identical
# tarballs (same dist.integrity), so it is listed as the primary fetch
# URL — it is dramatically faster from mainland China — with the
# canonical npmjs.org URL as fallback.

{ lib
, stdenv
, fetchurl
, autoPatchelfHook
, makeBinaryWrapper
, ripgrep
, # Linux-only runtime tools pinned into the wrapper's PATH.
  procps ? null
, bubblewrap ? null
, socat ? null
}:

let
  release = builtins.fromJSON (builtins.readFile ./hashes.json);

  # Nix system -> npm platform package suffix.
  platformMap = {
    "x86_64-linux"   = "linux-x64";
    "aarch64-linux"  = "linux-arm64";
    "x86_64-darwin"  = "darwin-x64";
    "aarch64-darwin" = "darwin-arm64";
  };

  target = platformMap.${stdenv.hostPlatform.system}
    or (throw "claude-code: unsupported system ${stdenv.hostPlatform.system}");

  pkg = release.platforms.${target};

  mirrorUrl =
    "https://registry.npmmirror.com/@anthropic-ai/claude-code-${target}/-/claude-code-${target}-${release.version}.tgz";

  # True when the build machine can run the produced binary (i.e. not a
  # cross build).
  canRunHere = stdenv.buildPlatform == stdenv.hostPlatform;
in
stdenv.mkDerivation {
  pname = "claude-code";
  version = release.version;

  src = fetchurl {
    urls = [ mirrorUrl pkg.url ];
    # SRI sha512 taken verbatim from the registry's dist.integrity field.
    hash = pkg.hash;
  };

  # Every platform tarball unpacks to a single "package/" directory.
  sourceRoot = "package";

  nativeBuildInputs = [ makeBinaryWrapper ]
    ++ lib.optionals stdenv.hostPlatform.isLinux [ autoPatchelfHook ];

  # The Linux binaries are dynamically linked against glibc basics;
  # stdenv.cc.cc.lib covers them.
  buildInputs = lib.optionals stdenv.hostPlatform.isLinux [ stdenv.cc.cc.lib ];

  # bun-compiled single-file executables carry an appended payload;
  # stripping would corrupt them.
  dontStrip = true;

  installPhase = ''
    runHook preInstall
    install -Dm755 claude $out/bin/.claude-unwrapped

    makeBinaryWrapper $out/bin/.claude-unwrapped $out/bin/claude \
      --inherit-argv0 \
      --set DISABLE_AUTOUPDATER 1 \
      --set DISABLE_INSTALLATION_CHECKS 1 \
      --set USE_BUILTIN_RIPGREP 0 \
      --prefix PATH : ${lib.makeBinPath (
        [ ripgrep ]
        ++ lib.optionals stdenv.hostPlatform.isLinux
             (builtins.filter (p: p != null) [ procps bubblewrap socat ])
      )}

    runHook postInstall
  '';

  # Install-time smoke test: the built binary must run and report our
  # exact version. Runs after fixupPhase so the Linux binary is already
  # patched by autoPatchelfHook.
  doInstallCheck = canRunHere;
  installCheckPhase = ''
    runHook preInstallCheck
    # claude wants a writable $HOME even for read-only invocations.
    export HOME=$(mktemp -d)
    output="$($out/bin/claude --version)"
    echo "claude --version: $output"
    case "$output" in
      "$version "*) ;;
      "$version") ;;
      *)
        echo "version check failed: expected $version, got: $output" >&2
        exit 1
        ;;
    esac
    runHook postInstallCheck
  '';

  meta = {
    description = "Agentic coding tool that lives in your terminal (prebuilt binary from npm)";
    homepage = "https://code.claude.com";
    license = lib.licenses.unfree;
    mainProgram = "claude";
    platforms = builtins.attrNames platformMap;
    sourceProvenance = [ lib.sourceTypes.binaryNativeCode ];
  };
}
